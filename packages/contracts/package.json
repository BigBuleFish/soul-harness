{
  "name": "@soul-harness/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Soul Harness protocol contracts: types, JSON Schema, enums and identifier formats. No IO, no state, no ID generation.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ajv": "^8.17.1"
  }
}
