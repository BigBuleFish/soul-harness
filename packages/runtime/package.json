{
  "name": "@soul-harness/runtime",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Soul Harness runtime. SH-008A delivers identifier allocation only: no persona lifecycle, event bus, scheduler, or database access.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@soul-harness/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
